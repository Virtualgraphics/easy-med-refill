{
  "expo": {
    "name": "easy-med-refill",
    "slug": "easy-med-refill",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "easymedrefill",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#005BAA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.anonymous.easymedrefill"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Easy MedRefill uses the camera only to read eMediplan QR codes and the codes on medicine packs."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#005BAA",
          "dark": {
            "backgroundColor": "#052A4F"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Easy MedRefill opens a photo only to read a medication list you choose."
        }
      ],
      "expo-localization",
      "./plugins/withShortCxxDir"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
