RewriteEngine On

# Let the certificate validation (Let's Encrypt HTTP-01) through untouched
RewriteRule ^\.well-known/ - [L]

# Never serve application code, config or cron scripts directly
RewriteRule ^(src|config|cron)(/|$) - [F,L]
RewriteRule ^schema\.sql$ - [F,L]
RewriteRule ^README\.md$ - [F,L]

# Force HTTPS for everything else
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Route everything to the front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# No directory listings, no caching of API responses
Options -Indexes
<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "no-referrer"
</IfModule>
